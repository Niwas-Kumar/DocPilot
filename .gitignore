# per-job scratch space and generated documents
work/
/output/
/tmp/

# never commit secrets or local config
.env
.env.*
*.pem
*.key
credentials*.json
token*.json
client_secret*.json
service_account*.json

# never commit source papers, samples or backups
UPSC sample/
*samples*/
restoration_points/
*.zip

# node / python build artefacts
frontend/node_modules/
__pycache__/
*.pyc
*.pyo

# local editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# never commit source or generated UPSC papers
*.tmp
~$*.docx
~$*.pdf

# desktop build output (PyInstaller) - 350MB+, rebuilt from docpilot.spec
/dist/
/build_tmp/

# local server logs
server_*.log
server_*.err

# local snapshot of the pre-2026-08-27 templates; git history already has them
assets/templates/_backup_*/

# generated by tools/version_info.py at build time
tools/file_version.txt

# client branding and templates (PW OnlyIAS) - private, copy in by hand
# see assets/README.md for the expected files
/assets/cover/
/assets/dea/
/assets/hindi_ca/
/assets/template/
/assets/templates/
